# Postgres (docker compose up -d). The app connects as salon_app, which is subject to RLS.
DATABASE_URL=postgres://salon_app:app@localhost:5564/salon
MIGRATION_DATABASE_URL=postgres://salon_owner:owner@localhost:5564/salon

BETTER_AUTH_SECRET=change-me-to-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Midtrans sandbox: https://dashboard.sandbox.midtrans.com > Settings > Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_IS_PRODUCTION=false
# Optional overrides (used by the fake Midtrans in CI)
# MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1
# MIDTRANS_API_URL=https://api.sandbox.midtrans.com/v2
